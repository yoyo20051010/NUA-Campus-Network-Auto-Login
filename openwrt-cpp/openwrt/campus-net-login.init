#!/bin/sh /etc/rc.common
# 校园网自动登录后台服务（OpenWrt procd，C++ 版）
#
# 和 Python 版相比只换了启动命令：不再需要 python3，直接跑静态二进制。

START=99
STOP=10
USE_PROCD=1

PROG=/etc/campus-net-login/campus-net-login

start_service() {
	procd_open_instance
	procd_set_param command "$PROG" --watch --quiet
	# 内存自保退出或异常崩溃后，procd 会自动拉起来
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# procd 会自动结束进程，这里无需额外处理
	:
}
