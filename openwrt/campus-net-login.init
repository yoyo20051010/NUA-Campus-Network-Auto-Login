#!/bin/sh /etc/rc.common
# 校园网自动登录后台服务（OpenWrt procd）

START=99
STOP=10
USE_PROCD=1

PROG=/etc/campus-net-login/campus_http.py

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/python3 "$PROG" --watch --quiet
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# procd 会自动结束进程，这里无需额外处理
	:
}
